generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy & staff ────────────────────────────────────────────────────

/// What shape of organization this is. Only decides which OrgLevel ladder
/// gets seeded at registration (see ORG_TEMPLATES) and some UI wording —
/// the structure itself is fully editable afterwards, so this is a
/// starting point rather than a constraint.
enum OrgType {
  SCHOOL
  COLLEGE
  COACHING
  TUTOR
}

/// A school, college, coaching center, or individual teacher's account.
/// The tenant boundary — every other model hangs off one institute.
model Institute {
  id        String   @id @default(cuid())
  name      String
  type      OrgType  @default(COACHING)
  createdAt DateTime @default(now())

  users     User[]
  students  Student[]
  orgLevels OrgLevel[]
  orgUnits  OrgUnit[]
  courses   Course[]
}

enum StaffRole {
  OWNER
  TEACHER
}

/// A teacher or institute owner. Always has platform access (unlike Student).
/// Passwordless — logs in via emailed OTP (see OtpCode).
model User {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  email       String    @unique
  role        StaffRole @default(TEACHER)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  taughtCourses    Course[]     @relation("CourseTeacher")
  markedAttendance Attendance[] @relation("AttendanceMarkedBy")
  recordedPayments FeePayment[] @relation("PaymentRecordedBy")
  invitedStudents  Student[]    @relation("StudentInvitedBy")

  @@index([instituteId])
}

// ─── Auth (passwordless OTP) ────────────────────────────────────────────

/// A one-time login code emailed to a User or Student. Identity isn't
/// stored here — verification re-resolves the email to whichever account
/// owns it — so this table only ever needs to know the email and the code.
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

// ─── Audit ──────────────────────────────────────────────────────────────

/// Append-only record of sensitive actions (student PII edits, invites,
/// attendance/payment changes, role changes, logins). Deliberately generic
/// — replaces one-off "who did X" columns (invitedById, markedById, ...)
/// as the actual answer to "who touched this record and when." Starting
/// scaffolding: wired into the highest-value mutations first, not
/// literally everything yet.
model AuditLog {
  id          String   @id @default(cuid())
  instituteId String?
  actorType   String // "STAFF" | "STUDENT" | "SYSTEM"
  actorId     String?
  action      String // e.g. "student.invite", "attendance.mark", "payment.record"
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([instituteId, createdAt])
  @@index([entityType, entityId])
}

// ─── Organization structure ─────────────────────────────────────────────

/// One rung of an institute's structure ladder, e.g. a school's
/// "Class" > "Section", a college's "Batch" > "Stream" > "Section", or a
/// coaching center's single "Batch". Purely a naming/UI scheme: it tells
/// the admin UI what to call a unit at a given depth ("Add a Section to
/// Class 12"). Units may exist deeper than the deepest defined level.
model OrgLevel {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  depth       Int // 0 = outermost
  createdAt   DateTime  @default(now())

  units OrgUnit[]

  @@unique([instituteId, depth])
  @@index([instituteId])
}

/// A node in the institute's structure tree — the single model behind a
/// school's "Class 12" and "Section A", a college's "Batch 2016" and
/// "Mechanical BTech", and a coaching center's "Dropper Batch".
///
/// Students enroll into *any* unit, and a unit's roster is everyone
/// enrolled in it or in any of its descendants — so enrolling students in
/// sections automatically rolls them up into the class. `path` is a
/// materialized "/ancestorId/.../selfId/" chain that makes both directions
/// cheap: descendants are a prefix match on path, and ancestors are read
/// straight out of the string with no query at all.
model OrgUnit {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children    OrgUnit[] @relation("OrgUnitTree")
  levelId     String?
  level       OrgLevel? @relation(fields: [levelId], references: [id])
  name        String
  path        String // "/rootId/.../selfId/" — includes self
  depth       Int    @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  enrollments   Enrollment[]
  courses       Course[]
  scheduleSlots ScheduleSlot[]
  sessions      ClassSession[]
  invoices      FeeInvoice[]
  feeStructure  FeeStructure?

  @@index([instituteId, isActive])
  @@index([instituteId, parentId])
  @@index([path])
}

/// How a course decides who is taking it.
enum CourseEnrollmentMode {
  /// Everyone on the org unit's roster (including descendant units).
  ALL_IN_UNIT
  /// Only students with an explicit CourseEnrollment — for electives and
  /// optional subjects, where one section splits across subjects.
  SELECTED
}

/// A subject taught to one org unit by one teacher — "Physics for 12A",
/// "Thermodynamics for Mechanical BTech", or the single subject an
/// individual tutor teaches their batch.
///
/// Attaching a course to a parent unit cascades it to every descendant, so
/// a school can put Maths on "Class 12" (both sections get it) while
/// putting Biology on "12A" alone.
model Course {
  id             String               @id @default(cuid())
  instituteId    String
  institute      Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  orgUnitId      String
  orgUnit        OrgUnit              @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  teacherId      String?
  teacher        User?                @relation("CourseTeacher", fields: [teacherId], references: [id])
  enrollmentMode CourseEnrollmentMode @default(ALL_IN_UNIT)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())

  courseEnrollments CourseEnrollment[]
  scheduleSlots     ScheduleSlot[]
  sessions          ClassSession[]

  @@index([instituteId, isActive])
  @@index([orgUnitId])
}

// ─── Students & enrollment ──────────────────────────────────────────────

/// A student's global login identity — passwordless (OTP-only), and
/// independent of any institute. A person creates exactly one of these
/// (self-signup or their first invite), then links to a Student row (a
/// per-institute membership) at every school/coaching-center they join.
model StudentAccount {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  memberships Student[]
}

enum ConsentStatus {
  NOT_REQUIRED
  PENDING
  CONFIRMED
}

/// A student's membership at one institute — their roster entry there:
/// enrollments, attendance, fees. Platform access is optional:
/// studentAccountId is null until a teacher invites them (by email, which
/// resolves-or-creates the StudentAccount) or the student signs up
/// themselves and a teacher later invites the same email.
model Student {
  id            String    @id @default(cuid())
  instituteId   String
  institute     Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  studentAccountId String?
  studentAccount   StudentAccount? @relation(fields: [studentAccountId], references: [id])
  invitedAt        DateTime?
  invitedById      String?
  invitedBy        User?           @relation("StudentInvitedBy", fields: [invitedById], references: [id])

  // Guardian consent for portal access. When guardianEmail is set at invite
  // time, the studentAccountId link above is created immediately but the
  // portal treats this membership as gated (PENDING) until the guardian
  // confirms via an emailed code (POST /api/consent/confirm). No guardian
  // email on file -> NOT_REQUIRED, matching pre-consent-feature behavior.
  // NOTE: this is technical scaffolding with sensible defaults, not legal
  // advice — review against applicable minors'-data-protection law before
  // relying on it.
  consentStatus      ConsentStatus @default(NOT_REQUIRED)
  consentConfirmedAt DateTime?

  enrollments       Enrollment[]
  courseEnrollments CourseEnrollment[]
  attendance        Attendance[]
  invoices          FeeInvoice[]

  @@index([instituteId])
  @@index([studentAccountId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

/// Which org unit a student sits in — their place in the structure tree.
/// Usually one active row (a school student is in exactly one section),
/// but several are allowed so a coaching student can attend more than one
/// batch.
model Enrollment {
  id         String           @id @default(cuid())
  orgUnitId  String
  orgUnit    OrgUnit          @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([orgUnitId, studentId])
  @@index([studentId])
}

/// Opts one student into one SELECTED-mode course. Unused for
/// ALL_IN_UNIT courses, where the org unit's roster is the course roster.
model CourseEnrollment {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([courseId, studentId])
  @@index([studentId])
}

// ─── Schedule ───────────────────────────────────────────────────────────

/// A recurring weekly time slot (e.g. "Mon/Wed/Fri 5–6pm") used to
/// generate concrete ClassSession rows. Belongs to an org unit, and
/// optionally to one of its courses — a slot with no course is an
/// unsubjected period, which is how a school books daily homeroom
/// attendance for a section.
model ScheduleSlot {
  id        String   @id @default(cuid())
  orgUnitId String
  orgUnit   OrgUnit  @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday .. 6 = Saturday
  startTime String // "HH:mm", 24-hour
  endTime   String // "HH:mm", 24-hour
  createdAt DateTime @default(now())

  @@index([orgUnitId])
  @@index([courseId])
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// A concrete, dated occurrence of a class — what attendance is taken
/// against. Generated from ScheduleSlots (or created ad hoc).
model ClassSession {
  id        String        @id @default(cuid())
  orgUnitId String
  orgUnit   OrgUnit       @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime // calendar date of the session (time-of-day zeroed)
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  status    SessionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())

  attendance Attendance[]

  // Guards against duplicate generation. Postgres treats NULLs as distinct,
  // so this does not constrain course-less (homeroom) sessions — session
  // generation does its own existence check to cover those.
  @@unique([orgUnitId, courseId, date, startTime])
  @@index([orgUnitId, date])
  @@index([courseId, date])
}

// ─── Attendance ─────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

/// One row per student per session.
model Attendance {
  id             String           @id @default(cuid())
  classSessionId String
  classSession   ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status         AttendanceStatus
  markedById     String?
  markedBy       User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedAt       DateTime         @default(now())

  @@unique([classSessionId, studentId])
  @@index([studentId])
}

// ─── Fees ───────────────────────────────────────────────────────────────

enum BillingCycle {
  ONE_TIME
  MONTHLY
  QUARTERLY
}

/// What an org unit costs, by default — used as a template when creating
/// invoices; invoices themselves can still be amount-overridden per student.
model FeeStructure {
  id            String       @id @default(cuid())
  orgUnitId     String       @unique
  orgUnit       OrgUnit      @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  amount        Decimal      @db.Decimal(10, 2)
  billingCycle  BillingCycle @default(MONTHLY)
  dueDayOfMonth Int? // e.g. 5 -> due the 5th of each cycle
  createdAt     DateTime     @default(now())
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

/// A specific amount owed by a specific student, independent of the fee
/// structure template so one-off charges/discounts are representable.
model FeeInvoice {
  id        String        @id @default(cuid())
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  orgUnitId String?
  orgUnit   OrgUnit?      @relation(fields: [orgUnitId], references: [id])
  amount    Decimal       @db.Decimal(10, 2)
  dueDate   DateTime
  status    InvoiceStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())

  payments FeePayment[]

  @@index([studentId])
  @@index([status])
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  OTHER
}

/// A payment recorded against an invoice. An invoice can have several
/// (partial payments); status on the invoice is derived from the sum.
model FeePayment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  paidAt       DateTime      @default(now())
  notes        String?
  recordedById String?
  recordedBy   User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([invoiceId])
}
